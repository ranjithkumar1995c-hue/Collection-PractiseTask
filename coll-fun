package CollectionsPractise;

import java.util.LinkedList;
import java.util.Queue;

public class QueuePractise {

	public static void main(String[] args) {
		Queue<String> q=new LinkedList<>();
		q.offer("ranjith");//Function.
		q.offer("ramu");
		q.offer("samu");
		q.offer("kavin");
		System.out.println("Queue:"+q);
		//See who is at the front
		System.out.println("Front person:"+q.peek());
		//Remove front person.
		System.out.println("Served:"+q.poll());
		System.out.println("After serving:"+q);
		
		

	}

}
(OUTPUT)=>Queue:[ranjith, ramu, samu, kavin]
Front person:ranjith
Served:ranjith
After serving:[ramu, samu, kavin]

